{
  "name": "@hugocxl/cxl-icons-react",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "SEE LICENSE IN THIRD_PARTY_LICENSES.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugocxl/cxl-icons.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "CXL SVG icons for react, with typed components and per-icon imports.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepack": "python3 ../../scripts/generate.py --check"
  }
}
